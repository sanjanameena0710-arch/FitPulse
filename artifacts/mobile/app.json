{
  "expo": {
    "name": "FitPulse - Fitness Tracker",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitpulse.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FitPulse uses your camera to count exercise reps and let you take progress photos.",
        "NSPhotoLibraryUsageDescription": "FitPulse needs access to your photo library so you can save and view progress photos."
      }
    },
    "android": {
      "package": "com.fitpulse.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A0A1A"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "FitPulse needs camera access to count reps and capture progress photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitPulse needs photo library access to save your progress photos.",
          "cameraPermission": "FitPulse needs camera access to take progress photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
